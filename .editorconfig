# C# style of this package, from docs/CodingStyle.md in the homework root (the authoritative guide).
# Rider and Visual Studio read this file (Settings | Editor | Code Style | Enable EditorConfig support).
root = true

[*]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
# Braces on their own line (Allman).
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
# A single-line body goes without braces; if one branch needs braces, all do.
csharp_prefer_braces = when_multiline
# Block-scoped namespaces.
csharp_style_namespace_declarations = block_scoped:warning
# var when the type is apparent; target-typed new().
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:silent
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion
# One-line members are expression-bodied.
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_style_expression_bodied_accessors = when_on_single_line:suggestion
# No `this.` qualification.
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
# Fields assigned only in the constructor are readonly.
dotnet_style_readonly_field = true:suggestion

# Private fields are _camelCase. [SerializeField] fields are plain camelCase; naming rules cannot see attributes,
# so this stays a suggestion and flags those fields (and private constants) for review.
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_rule.private_fields_camel_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_camel_underscore.style = camel_underscore
dotnet_naming_rule.private_fields_camel_underscore.severity = suggestion
dotnet_naming_style.camel_underscore.required_prefix = _
dotnet_naming_style.camel_underscore.capitalization = camel_case

# Interfaces start with I; type parameters start with T.
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i
dotnet_naming_rule.interfaces_start_with_i.severity = warning

dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_style.prefix_t.required_prefix = T
dotnet_naming_style.prefix_t.capitalization = pascal_case
dotnet_naming_rule.type_parameters_start_with_t.symbols = type_parameters
dotnet_naming_rule.type_parameters_start_with_t.style = prefix_t
dotnet_naming_rule.type_parameters_start_with_t.severity = suggestion
